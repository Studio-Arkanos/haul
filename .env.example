# ─── Stripe (mode test d'abord) — Dashboard → Developers → API keys ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Developers → Webhooks → endpoint /api/webhooks/stripe (event: checkout.session.completed)
# En dev local : `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# URL publique du site (success / cancel URLs)
SITE_URL=http://localhost:5173
VITE_SITE_URL=http://localhost:5173

# ─── Supabase — projet dédié « Haul » (eu-west-1) ───
# Dashboard Supabase → Project Settings → API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role JWT — SERVEUR uniquement, jamais côté client>
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon JWT — publique, sûre côté client grâce au RLS>

# ─── Emails transactionnels (optionnel, phase 2) ───
# EMAIL_PROVIDER_API_KEY=
